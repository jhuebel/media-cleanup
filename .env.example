APP_NAME="Media Cleanup"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

MEDIA_ROOT=/media
# 24h: individual ffmpeg conversions can run long; prevents a second worker
# from re-picking a job that's still running.
DB_QUEUE_RETRY_AFTER=86400

# --- docker-compose / Portainer stack settings ---------------------------
# These are read by docker-compose.yml itself (not by Laravel). Copy this
# file to .env in the same directory as docker-compose.yml, or paste the
# same keys into Portainer's stack "Environment variables" UI.
#
# MEDIA_PATH: host path to bind-mount into the container at /media.
# MEDIA_PATH=/mnt/nas/media
#
# APP_PORT: host port to publish the web UI on (default 8080).
# APP_PORT=8080
#
# PUID/PGID: numeric uid/gid of the account that owns your media on the
# host, so the container can read/write/delete/rename files under /media
# without permission errors. Find them with `id <user>` on the NAS.
# PUID=1000
# PGID=1000
#
# TZ: container timezone, e.g. America/New_York. Affects log timestamps
# and the daily conversion/cleanup schedule times.
# TZ=UTC
#
# APP_KEY: optional; if left unset the container generates one on first
# boot and persists it in the storage volume.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
